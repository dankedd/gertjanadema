---
permalink: exhibitions.html
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Google Consent Mode v2 + Google Tag Manager (keep before any other script) -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500
    });
    try { var c = localStorage.getItem('cookieConsent');
      if (c === 'granted' || c === 'denied') gtag('consent', 'update', { analytics_storage: c });
    } catch (e) {}
    dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
  </script>
  <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-K6KDLB95"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script>(function(){try{var l=localStorage.getItem('siteLang');if(l!=='nl'&&l!=='en')l='en';document.documentElement.setAttribute('data-lang',l);document.documentElement.lang=l;}catch(e){document.documentElement.setAttribute('data-lang','en');}})();</script>
  <title>Festivals &amp; Exhibitions — Gertjan Adema</title>
  <meta name="description" content="{{ site.exhibitions.google_description | esc | safe }}" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;700;800&family=Space+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="css/style.css" />
  <link rel="stylesheet" href="css/exhibitions.css" />
</head>
<body>

  <div class="loader" id="loader"><div class="loader__bar"></div></div>
  <div class="grain" aria-hidden="true"></div>
  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursorRing"></div>

  <div class="lang-toggle" role="group" aria-label="Language / Taal">
    <button data-lang-set="nl" type="button" aria-label="Nederlands">NL</button>
    <span class="lang-toggle__sep" aria-hidden="true">/</span>
    <button data-lang-set="en" type="button" aria-label="English">EN</button>
  </div>

  <a href="index.html" class="home-btn" aria-label="Home">← Home</a>

  <button class="nav-btn" id="navBtn" aria-label="Toggle navigation">
    <span class="nav-btn__line"></span>
    <span class="nav-btn__line"></span>
    <span class="nav-btn__line"></span>
  </button>

{% include "nav.njk" %}

  <!-- PAGE HEADER -->
  <header class="ex-header">
    <div class="ex-header__inner">
      <div class="ex-header__text">
        <h1 class="ex-header__title">
          <span class="lng lng--en">Festivals &amp;<br>Exhibitions</span>
          <span class="lng lng--nl">Festivals &amp;<br>Exposities</span>
        </h1>
        <p class="ex-header__sub">
          <span class="lng lng--en">A living archive of festivals and exhibitions across Europe</span>
          <span class="lng lng--nl">Een levend archief van festivals en exposities door heel Europa</span>
        </p>
      </div>
      <div class="ex-header__status" id="exHeaderStatus">
        <!-- Populated by JS -->
      </div>
    </div>
  </header>

  <!-- FILTER STRIP -->
  <div class="ex-filters" id="exFilters" role="group" aria-label="Filter exhibitions" data-aria-label-en="Filter exhibitions" data-aria-label-nl="Exposities filteren">
    <div class="ex-filters__inner">
      <div class="ex-filters__group ex-filters__group--pills">
        <button class="ex-pill ex-pill--all is-active" data-filter="installation" data-value="">
          <span class="lng lng--en">All</span><span class="lng lng--nl">Alle</span>
        </button>
        <button class="ex-pill ex-pill--connection" data-filter="installation" data-value="connection">
          <span class="ex-pill__dot"></span>Connection
        </button>
        <button class="ex-pill ex-pill--marbles" data-filter="installation" data-value="marbles">
          <span class="ex-pill__dot"></span>Marbles
        </button>
        <button class="ex-pill ex-pill--fragmented" data-filter="installation" data-value="fragmented">
          <span class="ex-pill__dot"></span>Fragmented
        </button>
        <button class="ex-pill ex-pill--melting" data-filter="installation" data-value="melting">
          <span class="ex-pill__dot"></span>Melting
        </button>
      </div>
      <div class="ex-filters__group ex-filters__group--selects">
        <select class="ex-select" id="filterYear" aria-label="Filter by year" data-aria-label-en="Filter by year" data-aria-label-nl="Filter op jaar">
          <option value="" data-en="All years" data-nl="Alle jaren">All years</option>
        </select>
        <select class="ex-select" id="filterCountry" aria-label="Filter by country" data-aria-label-en="Filter by country" data-aria-label-nl="Filter op land">
          <option value="" data-en="All countries" data-nl="Alle landen">All countries</option>
        </select>
      </div>
      <div class="ex-filters__count" id="exFilterCount">
        <span id="exFilterNum">–</span> <span class="lng lng--en">events</span><span class="lng lng--nl">evenementen</span>
      </div>
    </div>
  </div>

  <!-- TIMELINE SECTION -->
  <section class="ex-tl-section" id="timeline-section">
    <div class="ex-tl-section__inner">
      <header class="ex-tl-header reveal">
        <span class="section__num">07</span>
        <h2 class="ex-tl-title">
          <span class="lng lng--en">Living<br>Timeline</span>
          <span class="lng lng--nl">Levende<br>Tijdlijn</span>
        </h2>
      </header>

      <div class="ex-tl" id="exTimeline" role="list"></div>
      <noscript>
        <ul class="ex-noscript">
{%- for e in site.exhibitions.events %}
          <li><strong>{{ e.event_name | esc | safe }}</strong> — {{ e.city | esc | safe }}, {{ e.country | esc | safe }} — {{ e.date_start }}{% if e.date_end != e.date_start %} / {{ e.date_end }}{% endif %}{% if e.description %} — {{ e.description | esc | safe }}{% endif %}</li>
{%- endfor %}
        </ul>
      </noscript>

      <div class="ex-tl-empty" id="exTlEmpty" aria-live="polite">
        <span class="lng lng--en">No exhibitions match the current filters.</span>
        <span class="lng lng--nl">Geen exposities komen overeen met de huidige filters.</span>
      </div>
    </div>
  </section>

  <!-- DETAIL CARD (modal) -->
  <div class="ex-card-overlay" id="exCardOverlay" aria-hidden="true"></div>
  <aside class="ex-card" id="exCard" role="dialog" aria-modal="true" aria-label="Exhibition details" data-aria-label-en="Exhibition details" data-aria-label-nl="Details van de expositie" aria-hidden="true">
    <button class="ex-card__close" id="exCardClose" aria-label="Close details" data-aria-label-en="Close details" data-aria-label-nl="Details sluiten">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <div class="ex-card__inner" id="exCardInner">
      <!-- Populated by JS -->
    </div>
  </aside>

  <!-- FOOTER -->
  <footer class="ex-footer">
    <div class="ex-footer__inner">
      <a href="index.html" class="ex-footer__back">← Portfolio</a>
      <span class="ex-footer__name">Gertjan Adema — Exhibitions</span>
      <button type="button" class="ex-footer__cv cookie-settings-link" data-cookie-settings><span class="lng lng--en">Cookie settings</span><span class="lng lng--nl">Cookie-instellingen</span></button>
      <a href="contact.html" class="ex-footer__cv">Contact →</a>
    </div>
  </footer>

  <script src="js/main.js"></script>
  <script src="js/consent.js"></script>
  <script type="application/json" id="exData">{{ site.exhibitions.events | json | safe }}</script>
  <script src="js/exhibitions.js"></script>
</body>
</html>

---
permalink: connection.html
---
{% set w = site.works.connection %}{% set nxt = site.works.marbles %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Google Consent Mode v2 + Google Tag Manager (keep before any other script) -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500
    });
    try { var c = localStorage.getItem('cookieConsent');
      if (c === 'granted' || c === 'denied') gtag('consent', 'update', { analytics_storage: c });
    } catch (e) {}
    dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
  </script>
  <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-K6KDLB95"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script>(function(){try{var l=localStorage.getItem('siteLang');if(l!=='nl'&&l!=='en')l='en';document.documentElement.setAttribute('data-lang',l);document.documentElement.lang=l;}catch(e){document.documentElement.setAttribute('data-lang','en');}})();</script>
  <title>{{ w.title | esc | safe }} — Gertjan Adema</title>
  <meta name="description" content="{{ site.works.connection.google_description | esc | safe }}" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=Space+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="css/style.css" />
  <link rel="stylesheet" href="css/install.css" />
</head>
<body class="install-page page--connection">

  <div class="loader" id="loader"><div class="loader__bar"></div></div>
  <div class="grain" aria-hidden="true"></div>
  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursorRing"></div>

  <div class="lang-toggle" role="group" aria-label="Language / Taal">
    <button data-lang-set="nl" type="button" aria-label="Nederlands">NL</button>
    <span class="lang-toggle__sep" aria-hidden="true">/</span>
    <button data-lang-set="en" type="button" aria-label="English">EN</button>
  </div>

  <button class="nav-btn" id="navBtn" aria-label="Toggle navigation">
    <span class="nav-btn__line"></span>
    <span class="nav-btn__line"></span>
    <span class="nav-btn__line"></span>
  </button>

{% include "nav.njk" %}

  <!-- ============================================================
       EXHIBITION LAYOUT
  ============================================================ -->
  <div class="exh-layout">

    <!-- LEFT: INFO PANEL -->
    <aside class="exh-panel">
      <div class="exh-panel__inner">

        <a href="index.html" class="exh-panel__back">← Gertjan Adema</a>

        <span class="exh-panel__num">{{ w.num }} / 05</span>
        <h1 class="exh-panel__title">{% if w.en.title == w.nl.title %}{{ w.en.title | titleBreak | safe }}{% else %}<span class="lng lng--en">{{ w.en.title | titleBreak | safe }}</span><span class="lng lng--nl">{{ w.nl.title | titleBreak | safe }}</span>{% endif %}</h1>
        <p class="exh-panel__subtitle">
          <span class="lng lng--en">{{ w.en.subtitle | esc | safe }}</span>
          <span class="lng lng--nl">{{ w.nl.subtitle | esc | safe }}</span>
        </p>

        <div class="exh-divider"></div>

        <dl class="exh-specs lng lng--en">
{%- for s in w.en.specs %}
          <dt>{{ s.label | esc | safe }}</dt> <dd>{{ s.value | esc | safe }}</dd>
{%- endfor %}
        </dl>
        <dl class="exh-specs lng lng--nl">
{%- for s in w.nl.specs %}
          <dt>{{ s.label | esc | safe }}</dt> <dd>{{ s.value | esc | safe }}</dd>
{%- endfor %}
        </dl>

        <div class="exh-divider"></div>

        <div class="exh-actions">
          <button class="exh-btn" data-modal="info" aria-label="More info / Meer info">
            <span><span class="lng lng--en">More Info</span><span class="lng lng--nl">Meer info</span></span> <span class="exh-btn__arrow">→</span>
          </button>
          <button class="exh-btn" data-modal="demo" aria-label="Watch demo / Bekijk demo">
            Demo <span class="exh-btn__arrow">→</span>
          </button>
          <a href="{{ nxt.url }}" class="exh-btn exh-btn--next">
            <span><span class="lng lng--en">Next —</span><span class="lng lng--nl">Volgende —</span></span> {{ nxt.en.title | bi(nxt.nl.title) | safe }} <span class="exh-btn__arrow">→</span>
          </a>
        </div>

      </div>
    </aside>

    <!-- RIGHT: GALLERY -->
    <main class="exh-gallery">
      <div class="carousel" id="carousel-connection" data-carousel>
        <div class="carousel__track">
          <div class="carousel__slide">
            <img src="assets/images/connection/connection-01.jpeg" alt="Connection — magenta light trails with glowing blue node" loading="eager" />
          </div>
          <div class="carousel__slide">
            <img src="assets/images/connection/connection-02.jpeg" alt="Connection — blue neon track at dusk in a park" loading="lazy" />
          </div>
          <div class="carousel__slide">
            <picture>
              <source type="image/webp"
                      srcset="assets/images/connection/connection-11-1000.webp 1000w, assets/images/connection/connection-11-2000.webp 2000w"
                      sizes="(max-width: 768px) 100vw, 70vw" />
              <img src="assets/images/connection/connection-11-1000.jpg"
                   srcset="assets/images/connection/connection-11-1000.jpg 1000w, assets/images/connection/connection-11-2000.jpg 2000w"
                   sizes="(max-width: 768px) 100vw, 70vw"
                   width="2000" height="1500" loading="lazy"
                   alt="Connection — glowing yellow Möbius marble run at dusk in an illuminated park, with visitors"
                   data-alt-en="Connection — glowing yellow Möbius marble run at dusk in an illuminated park, with visitors"
                   data-alt-nl="Connection — geel oplichtende möbius-knikkerbaan in de schemering in een verlicht park, met bezoekers" />
            </picture>
          </div>
          <div class="carousel__slide">
            <img src="assets/images/connection/connection-03.jpeg" alt="Connection — red neon track in a town square at night with crowd" loading="lazy" />
          </div>
          <div class="carousel__slide">
            <picture>
              <source type="image/webp"
                      srcset="assets/images/connection/connection-12-1000.webp 1000w, assets/images/connection/connection-12-2000.webp 2000w"
                      sizes="(max-width: 768px) 100vw, 70vw" />
              <img src="assets/images/connection/connection-12-1000.jpg"
                   srcset="assets/images/connection/connection-12-1000.jpg 1000w, assets/images/connection/connection-12-2000.jpg 2000w"
                   sizes="(max-width: 768px) 100vw, 70vw"
                   width="2000" height="1500" loading="lazy"
                   alt="Connection — glowing magenta Möbius marble run at night in a park, with visitors gathered around"
                   data-alt-en="Connection — glowing magenta Möbius marble run at night in a park, with visitors gathered around"
                   data-alt-nl="Connection — magenta oplichtende möbius-knikkerbaan bij nacht in een park, met bezoekers eromheen" />
            </picture>
          </div>
          <div class="carousel__slide">
            <img src="assets/images/connection/connection-04.jpeg" alt="Connection — daylight view of the steel frame during assembly" loading="lazy" />
          </div>
          <div class="carousel__slide">
            <img src="assets/images/connection/connection-05.jpeg" alt="Connection — the artist building the installation frame" loading="lazy" />
          </div>
          <div class="carousel__slide">
            <img src="assets/images/connection/connection-06.jpeg" alt="Connection — red and green light trails with glowing orange node" loading="lazy" />
          </div>
          <div class="carousel__slide">
            <img src="assets/images/connection/connection-07.jpeg" alt="Connection — the artist beside the installation with a glowing pink node" loading="lazy" />
          </div>
          <div class="carousel__slide">
            <img src="assets/images/connection/connection-08.jpeg" alt="Connection — blue and purple light trails with glowing green node" loading="lazy" />
          </div>
          <div class="carousel__slide">
            <img src="assets/images/connection/connection-09.jpeg" alt="Connection — light trails mirrored in water with glowing green node" loading="lazy" />
          </div>
          <div class="carousel__slide">
            <img src="assets/images/connection/connection-10.jpeg" alt="Connection — close-up of purple neon track at night with glowing orange node" loading="lazy" />
          </div>
        </div>
        <div class="carousel__counter" aria-live="polite"></div>
        <button class="carousel__btn carousel__btn--prev" aria-label="Previous slide">&#8249;</button>
        <button class="carousel__btn carousel__btn--next" aria-label="Next slide">&#8250;</button>
        <div class="carousel__dots"></div>
      </div>
    </main>

  </div><!-- /.exh-layout -->

  <!-- ============================================================
       INFO MODAL
  ============================================================ -->
  <div class="exh-modal" id="modal-info" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="modal-info-title">
    <div class="exh-modal__backdrop"></div>
    <div class="exh-modal__panel">
      <button class="exh-modal__close" aria-label="Close">✕</button>
      <span class="exh-modal__num">{{ w.num }} — {{ w.en.title | bi(w.nl.title) | safe }}</span>
      <h2 class="exh-modal__title" id="modal-info-title">
        <span class="lng lng--en">{{ w.en.info_title | nl2br | safe }}</span>
        <span class="lng lng--nl">{{ w.nl.info_title | nl2br | safe }}</span>
      </h2>
      <div class="exh-modal__body">
        <div class="lng lng--en">
          {{ w.en.body | md | safe }}
        </div>
        <div class="lng lng--nl">
          {{ w.nl.body | md | safe }}
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       DEMO MODAL
       To enable video: add data-yt="YOUTUBE_ID" to the div below.
  ============================================================ -->
  <div class="exh-modal exh-modal--video" id="modal-demo" data-yt="AUUAZeIIocs" role="dialog" aria-modal="true" aria-hidden="true" aria-label="{{ w.title | esc | safe }} demo reel">
    <div class="exh-modal__backdrop"></div>
    <div class="exh-modal__panel">
      <button class="exh-modal__close" aria-label="Close">✕</button>
      <div class="exh-modal__video-wrap">
        <div class="exh-modal__video-placeholder">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="0.8"/>
            <polygon points="10,8 17,12 10,16" fill="currentColor"/>
          </svg>
          <span>Demo reel coming soon</span>
        </div>
      </div>
    </div>
  </div>

  <script src="js/main.js"></script>
  <script src="js/consent.js"></script>
  <script src="js/install.js"></script>
</body>
</html>

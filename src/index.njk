<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Google Consent Mode v2 + Google Tag Manager (keep before any other script) -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500
    });
    try { var c = localStorage.getItem('cookieConsent');
      if (c === 'granted' || c === 'denied') gtag('consent', 'update', { analytics_storage: c });
    } catch (e) {}
    dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
  </script>
  <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-K6KDLB95"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script>(function(){try{var l=localStorage.getItem('siteLang');if(l!=='nl'&&l!=='en')l='en';document.documentElement.setAttribute('data-lang',l);document.documentElement.lang=l;}catch(e){document.documentElement.setAttribute('data-lang','en');}})();</script>
  <title>Gertjan Adema — Kinetic Light Installations</title>
  <meta name="description" content="{{ site.home.google_description | esc | safe }}" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;700;800&family=Space+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="css/style.css" />
</head>
<body data-page="home">

  <div class="loader" id="loader"><div class="loader__bar"></div></div>
  <div class="grain" aria-hidden="true"></div>
  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursorRing"></div>

  <div class="lang-toggle" role="group" aria-label="Language / Taal">
    <button data-lang-set="nl" type="button" aria-label="Nederlands">NL</button>
    <span class="lang-toggle__sep" aria-hidden="true">/</span>
    <button data-lang-set="en" type="button" aria-label="English">EN</button>
  </div>

  <button class="nav-btn" id="navBtn" aria-label="Toggle navigation">
    <span class="nav-btn__line"></span>
    <span class="nav-btn__line"></span>
    <span class="nav-btn__line"></span>
  </button>

{% include "nav.njk" %}

  <!-- Installation sidebar (desktop only) -->
  <nav class="install-nav" aria-label="Installations">
{%- for w in site.works.list %}
    <a href="{{ w.url }}" class="install-nav__link">{{ w.en.title | bi(w.nl.title) | safe }}</a>
{%- endfor %}
  </nav>

  <!-- ============================================================
       HERO
  ============================================================ -->
  <section class="hero" id="hero">
    <div class="hero__media">

      <!-- ═══ BACKGROUND VIDEO ═════════════════════════════════
           Local file: assets/video/website-index-web.mp4 (web-compressed)
      ══════════════════════════════════════════════════════════ -->
      <video id="heroVideo" class="hero__video"
             autoplay muted loop playsinline preload="auto">
        <source src="assets/video/website-index-web.mp4" type="video/mp4">
      </video>

      <!-- Fallback: animated orbs — visible while YT loads or if unavailable -->
      <div class="hero__fallback" id="heroFallback">
        <div class="hero__orb hero__orb--1"></div>
        <div class="hero__orb hero__orb--2"></div>
        <div class="hero__orb hero__orb--3"></div>
      </div>

    </div>
    <div class="hero__overlay"></div>

    <div class="hero__content">
      <h1 class="hero__name" data-text="gertjan adema">gertjan adema</h1>
      <span class="hero__subtitle">
        <span class="lng lng--en">{{ site.home.en.subtitle | esc | safe }}</span>
        <span class="lng lng--nl">{{ site.home.nl.subtitle | esc | safe }}</span>
      </span>
      <span class="hero__motto">
        <span class="lng lng--en">{{ site.home.en.motto | esc | safe }}</span>
        <span class="lng lng--nl">{{ site.home.nl.motto | esc | safe }}</span>
      </span>
    </div>

  </section>

  <!-- ============================================================
       WORKS INDEX
  ============================================================ -->
  <section class="works-index" aria-label="Installations">
{%- for w in site.works.list %}
    <a href="{{ w.url }}" class="works-index__item reveal"{% if not loop.first %} data-delay="{{ loop.index0 * 60 }}"{% endif %}>
      <span class="works-index__num">{{ w.num }}</span>
      <span class="works-index__title">{{ w.en.title | bi(w.nl.title, "lower") | safe }}</span>
      <span class="works-index__arrow" aria-hidden="true">→</span>
    </a>
{%- endfor %}
  </section>

  <!-- ============================================================
       FOOTER
  ============================================================ -->
  <footer class="index-footer">
    <a href="mailto:info@gertjanadema.nl" class="index-footer__email">info@gertjanadema.nl</a>
    <nav class="index-footer__social" aria-label="Social media">
      <a href="https://www.instagram.com/gertjanadema" class="index-footer__link social-link" target="_blank" rel="noopener noreferrer"
         aria-label="Gertjan Adema on Instagram" data-aria-label-en="Gertjan Adema on Instagram" data-aria-label-nl="Gertjan Adema op Instagram"><svg class="social-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none"/></svg><span>Instagram</span></a>
      <a href="https://www.linkedin.com/in/gertjan-adema-0b150531/" class="index-footer__link social-link" target="_blank" rel="noopener noreferrer"
         aria-label="Gertjan Adema on LinkedIn" data-aria-label-en="Gertjan Adema on LinkedIn" data-aria-label-nl="Gertjan Adema op LinkedIn"><svg class="social-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11.25H3zM9.5 9.75h3.8v1.6h.06c.53-.95 1.82-1.95 3.75-1.95 4 0 4.74 2.5 4.74 5.77V21h-4v-5.2c0-1.24-.02-2.84-1.83-2.84-1.83 0-2.11 1.36-2.11 2.75V21h-4z"/></svg><span>LinkedIn</span></a>
      <a href="https://www.facebook.com/gertjan.adema/" class="index-footer__link social-link" target="_blank" rel="noopener noreferrer"
         aria-label="Gertjan Adema on Facebook" data-aria-label-en="Gertjan Adema on Facebook" data-aria-label-nl="Gertjan Adema op Facebook"><svg class="social-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.5 21v-7.6h2.6l.4-3h-3V8.5c0-.87.25-1.46 1.5-1.46h1.6V4.36A21 21 0 0 0 14.27 4.2c-2.3 0-3.87 1.4-3.87 3.97v2.23H7.8v3h2.6V21z"/></svg><span>Facebook</span></a>
    </nav>
    <nav class="index-footer__links" aria-label="Footer navigation">
      <a href="about.html" class="index-footer__link">About the Artist</a>
      <a href="exhibitions.html" class="index-footer__link">Exhibitions</a>
      <a href="contact.html" class="index-footer__link">Contact</a>
      <button type="button" class="index-footer__link cookie-settings-link" data-cookie-settings><span class="lng lng--en">Cookie settings</span><span class="lng lng--nl">Cookie-instellingen</span></button>
    </nav>
  </footer>

  <script src="js/main.js"></script>
  <script src="js/consent.js"></script>
</body>
</html>
